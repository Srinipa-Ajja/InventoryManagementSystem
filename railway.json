{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "cd Inventory_management/backend && npm install && cd ../frontend && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "node Inventory_management/backend/server.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
